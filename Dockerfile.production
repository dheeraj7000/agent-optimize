FROM python:3.11-slim AS builder

WORKDIR /app
RUN pip install --no-cache-dir --upgrade pip
COPY pyproject.toml README.md ./
COPY src/ src/
RUN pip install --no-cache-dir .

FROM python:3.11-slim
WORKDIR /app
COPY --from=builder /usr/local /usr/local
COPY src/ src/
COPY config.example.yaml config.yaml
RUN mkdir -p /data && useradd -r -s /bin/false appuser && chown -R appuser:appuser /data
USER appuser
ENV AGENTOPTIMIZE_ENV=production \
    AGENTOPTIMIZE_DB_PATH=/data/agentoptimize.db \
    AGENTOPTIMIZE_LOG_FORMAT=json \
    AGENTOPTIMIZE_LOG_LEVEL=info \
    AGENTOPTIMIZE_API_KEY_REQUIRED=true \
    PYTHONUNBUFFERED=1
EXPOSE 8080
CMD ["uvicorn", "agent_optimize.api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8080"]
